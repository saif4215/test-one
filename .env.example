# Copy to .env.local and fill in only what you use. Everything is optional.

# Where the SQLite database lives (default: ./data/reseller.db)
# DATABASE_PATH=./data/reseller.db

# Require a password for every page (strongly recommended when the app is online)
# APP_PASSWORD=

# Enables POST /api/deal-finder for external schedulers (send "Authorization: Bearer <secret>")
# CRON_SECRET=

# --- Amazon Selling Partner API (free with a seller account) ---
# SPAPI_CLIENT_ID=
# SPAPI_CLIENT_SECRET=
# SPAPI_REFRESH_TOKEN=
# SPAPI_SELLER_ID=
# SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER

# --- Google Sheets sync (free; your own Google Cloud service account) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=reseller@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# --- Google price lookup (Custom Search JSON API) ---
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=

# ======================================================================
# Maruf Cafe purchase agreements + e-signature (see docs/AGREEMENTS.md)
# Create the first administrator with: npm run agreements:admin -- you@example.com "Your Name"
# ======================================================================

# Public address of this site. Used in links inside emails. REQUIRED in production (https://...).
# APP_URL=https://your-site.example.com

# Random secret (16+ characters) that keys one-time-code hashes and signer sessions. REQUIRED in production.
# Generate one with: openssl rand -base64 32
# APP_SECRET=

# 32 random bytes, base64. Encrypts uploaded and signed documents at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32     BACK THIS UP: lose it and the stored files can't be read.
# FILE_ENCRYPTION_KEY=
# Where private files live (default: a "files" folder next to the database). Keep it on the persistent disk.
# UPLOAD_DIR=./data/files

# First-run only (e.g. in Docker): creates this administrator on the first sign-in attempt when no users exist. Remove afterwards.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- E-signature provider: DocuSign (sandbox = demo; the sandbox is free) ---
# DOCUSIGN_ENV=demo                      # demo | production
# DOCUSIGN_INTEGRATION_KEY=              # the app's "Integration Key" (a GUID)
# DOCUSIGN_USER_ID=                      # the API user's GUID (impersonated through JWT)
# DOCUSIGN_ACCOUNT_ID=                   # API Account ID (GUID)
# DOCUSIGN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"   # RSA private key for JWT
# DOCUSIGN_CONNECT_HMAC_SECRET=          # the HMAC key from DocuSign Connect (verifies webhooks)
# DOCUSIGN_BASE_URI=                     # optional; otherwise looked up from your account

# --- Email: Resend (send from a domain you have verified) ---
# RESEND_API_KEY=
# EMAIL_FROM="Maruf Cafe Deals <deals@your-verified-domain.com>"
# RESEND_WEBHOOK_SECRET=                 # "whsec_..." from the Resend webhook; enables delivery confirmations

# Lets a scheduler call POST /api/agreements/maintenance (expire requests, remind signers, retry downloads)
# CRON_SECRET is already described above.
# Only for local testing without a key; refused in production unless set to "true":
# ALLOW_UNENCRYPTED_STORAGE=false
