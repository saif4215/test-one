# Copy to .env.local and fill in only what you use. Everything is optional.

# Where the SQLite database lives (default: ./data/reseller.db)
# DATABASE_PATH=./data/reseller.db

# Require a password for every page (strongly recommended when the app is online)
# APP_PASSWORD=

# Enables POST /api/deal-finder for external schedulers (send "Authorization: Bearer <secret>")
# CRON_SECRET=

# --- Amazon Selling Partner API (free with a seller account) ---
# SPAPI_CLIENT_ID=
# SPAPI_CLIENT_SECRET=
# SPAPI_REFRESH_TOKEN=
# SPAPI_SELLER_ID=
# SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER

# --- Google Sheets sync (free; your own Google Cloud service account) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=reseller@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# --- Google price lookup (Custom Search JSON API) ---
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=
