# Square checkout. Copy these into your host's environment settings. Never commit real values.
SQUARE_ENV=sandbox                 # "sandbox" for testing, "production" for real charges
SQUARE_ACCESS_TOKEN=               # Square Developer Dashboard > your app > Credentials (keep secret)
SQUARE_LOCATION_ID=                # Square Dashboard > Account & Settings > Business > Locations
SQUARE_APP_ID=                     # Square Developer Dashboard > your app > Credentials (application ID)
TAX_PERCENT=                       # sales tax in percent. NYC combined rate is 8.875, confirm yours. Empty means no tax.
PORT=8080
