# Square checkout. Copy these into your host's environment settings. Never commit real values.
SQUARE_ENV=sandbox                 # "sandbox" for testing, "production" for real charges
SQUARE_ACCESS_TOKEN=               # Square Developer Dashboard > your app > Credentials (keep secret)
SQUARE_LOCATION_ID=                # Square Dashboard > Account & Settings > Business > Locations
SQUARE_APP_ID=                     # Square Developer Dashboard > your app > Credentials (application ID)
TAX_PERCENT=                       # sales tax in percent. NYC combined rate is 8.875, confirm yours. Empty means no tax.
PORT=8080

# Quote and event requests from the app. They are always saved to data/inquiries.jsonl.
# On a host with temporary disk (some free plans) also set one of these, or requests can be lost on restart.
INQUIRY_WEBHOOK_URL=               # Slack / Zapier / Make / Discord webhook that receives each request
RESEND_API_KEY=                    # email notifications through resend.com
NOTIFY_EMAIL=                      # who gets the email (comma-separated)
NOTIFY_FROM=                       # e.g. Maruf Cafe <requests@yourdomain.com> (must be a domain you verified with Resend)
ADMIN_PASSWORD=                    # password for /admin/requests (leave empty to switch that page off)
ALLOWED_ORIGIN=*                   # the app calls this server from another origin
DATA_DIR=                          # where requests are saved (default: ./data)
