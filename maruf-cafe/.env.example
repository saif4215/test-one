# Copy these into your host's environment settings (Render: Environment). Never commit real values.

# ---- Staff dashboard at /admin/ ------------------------------------------------------------------
ADMIN_USER=owner                   # sign-in name for the owner (default: owner)
ADMIN_PASSWORD=                    # REQUIRED to switch the dashboard on. At least 10 characters. Owner can do everything.
STAFF_USER=staff                   # sign-in name for staff (default: staff)
STAFF_PASSWORD=                    # optional, at least 10 characters. Staff see and update requests only.
STAFF_CAN_EDIT_SITE=               # staff can already edit the menu and prices. Set to 1 to let them also edit site info and photos
PUBLIC_URL=                        # the website's real address, e.g. https://maruf-cafe.onrender.com (used in emails, canonical links, sitemap)

# TRUST_PROXY=1                   # behind a proxy/load balancer: use X-Forwarded-For for rate limits. Automatic on Render. Never set it if the server is reachable directly.

# ---- Where requests are kept ---------------------------------------------------------------------
DATA_DIR=                          # folder for the database (maruf.db) and uploaded photos. Default: ./data
                                   # On a host with temporary disk (Render free plan) this is erased on restart: use email/webhook below too.

# ---- Tell the owner when a request arrives (set at least one) ------------------------------------
RESEND_API_KEY=                    # email through resend.com (the key stays on the server)
NOTIFY_EMAIL=                      # who gets the email (comma-separated)
NOTIFY_FROM=                       # e.g. Maruf Cafe <requests@yourdomain.com>. Must be on a domain verified in Resend.
                                   # Empty = onboarding@resend.dev, which Resend only lets you send to your own Resend sign-up email.
INQUIRY_WEBHOOK_URL=               # Slack / Discord / Zapier / Make webhook that receives each request

# ---- AI assistant in the app ("Ask Maruf Cafe") ---------------------------------------------------
ANTHROPIC_API_KEY=                 # from console.anthropic.com > API keys. Empty = the chat still works, with built-in answers from your menu and details (no AI).
ASSISTANT_MODEL=                   # optional. Default: claude-haiku-5-5 (fast and low cost)
# Or use ANY OpenAI-style AI service instead (many have a free tier). Set all three:
AI_API_KEY=                        # the key from that service (free to create)
AI_BASE_URL=                       # must be https. e.g. https://api.groq.com/openai/v1  or  https://openrouter.ai/api/v1
                                   # or https://generativelanguage.googleapis.com/v1beta/openai  (check the service's docs)
AI_MODEL=                          # a model name from that service's list. Pick one marked free. Names change, so check.
ASSISTANT_RATE_LIMIT_PER_MIN=      # questions per visitor per minute (default 6)
ASSISTANT_DAILY_LIMIT=             # total questions per day across everyone (default 300). Your spending cap.

# ---- Phone app ---------------------------------------------------------------------------------
ALLOWED_ORIGIN=*                   # which web origin may call the request endpoints (the phone app calls from elsewhere)

# ---- Square checkout (card payments for menu items; NOT used for quotes or bookings) ---------------
SQUARE_ENV=sandbox                 # "sandbox" for testing, "production" for real charges
SQUARE_ACCESS_TOKEN=               # Square Developer Dashboard > your app > Credentials (keep secret)
SQUARE_LOCATION_ID=                # Square Dashboard > Account & Settings > Business > Locations
SQUARE_APP_ID=                     # Square Developer Dashboard > your app > Credentials (application ID)
TAX_PERCENT=                       # sales tax in percent. NYC combined rate is 8.875, confirm yours. Empty means no tax.

PORT=8080
